{
  "name": "neighbor-help",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:protocol": "node --import tsx _qa/protocol.ts",
    "test:danger": "node --import tsx _qa/danger-director.ts",
    "test:payment": "node --import tsx _qa/payment-consistency.ts",
    "test:turn": "node --import tsx _qa/turn-consistency.ts",
    "test:character-debut": "node --import tsx _qa/character-debut.ts",
    "test:shared-world": "node --import tsx _qa/shared-world-engine.ts",
    "test:shared-story-authority": "node --import tsx _qa/shared-story-authority.ts",
    "test:receipts": "node --import tsx _qa/receipt-reconciliation.ts",
    "test:save-envelope": "node --import tsx _qa/save-envelope.ts",
    "test:gateway-recovery": "node --import tsx _qa/gateway-recovery.ts",
    "test:authority:remote": "node --import tsx _qa/remote-authority.ts",
